# Copy to .env for local development, or paste these as Environment Variables
# in the Vercel project settings for production.

# --- Database (required) ----------------------------------------------------
# Production: a MongoDB Atlas M0 connection string.
MONGO_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="manan_portfolio"

# Local-only escape hatch: run against an in-process fake instead of a real
# mongod. Ignored outside development.
USE_MEMORY_DB=0

# --- Auth (required) --------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start in production while this is left at its dev default.
JWT_SECRET=""
JWT_EXPIRE_HOURS=12

# Used by seed.py to create the admin login. Remove ADMIN_PASSWORD from the
# environment once the account exists.
ADMIN_EMAIL="admin@manankmehta.com"
ADMIN_PASSWORD=""

# --- CORS -------------------------------------------------------------------
# Frontend and API share an origin on Vercel, so this matters only locally.
CORS_ORIGINS="http://localhost:3000"

# --- Cloudinary (image uploads) ---------------------------------------------
# From the Cloudinary dashboard. Blank disables uploads and leaves the admin
# panel's URL field working.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="manan-portfolio"

# --- Email (contact form notifications) -------------------------------------
# From resend.com. Blank disables notifications; messages are still stored and
# readable in the admin inbox.
RESEND_API_KEY=""
# Must be on a domain verified in Resend. onboarding@resend.dev works for
# testing but can only deliver to your own Resend account address.
MAIL_FROM="onboarding@resend.dev"
CONTACT_NOTIFY_EMAIL="connect@manankmehta.com"
